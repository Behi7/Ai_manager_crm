# Database configuration (PostgreSQL + asyncpg)
DATABASE_URL=postgresql+asyncpg://ai_user:ai_secure_password_123@127.0.0.1:5433/ai_manager

# Redis cache and queue
REDIS_URL=redis://127.0.0.1:6380/0

# Fernet secret key for encrypting amoCRM access tokens in database (32 url-safe base64 bytes)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=your_fernet_secret_key_here

# Google Gemini API key (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Server host and port
HOST=0.0.0.0
PORT=8080

# Public URL for amoCRM webhooks (e.g. ngrok tunnel or domain name)
BASE_URL=https://your-domain.ngrok-free.dev
